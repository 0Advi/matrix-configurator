# Matrix Configurator — environment template.
# Copy to `.env` (gitignored) and fill in real values. Never commit `.env`.
# Values must not contain `$`, quotes or spaces (docker compose interpolates this file).

# ---------------------------------------------------------------------------
# Contract keys (read by web/server.mjs and nocobase/lib/client.mjs)
# ---------------------------------------------------------------------------
NOCOBASE_URL=http://localhost:13000
NOCOBASE_ROOT_EMAIL=admin@configurator.local
NOCOBASE_ROOT_PASSWORD=change-me-strong-random-password
# Optional long-lived API key (root role). Written by `npm run provision` when the
# API Keys plugin is available. If empty, the client signs in with the ROOT creds.
NOCOBASE_TOKEN=
WEB_PORT=4300

# ---------------------------------------------------------------------------
# Docker stack (read only by docker-compose.yml)
# ---------------------------------------------------------------------------
# Host port that maps to the NocoBase container's nginx (container port 80).
NOCOBASE_HTTP_PORT=13000
# Secret used by NocoBase to sign tokens. Changing it invalidates all tokens/API keys.
NOCOBASE_APP_KEY=change-me-64-hex-chars
# Root user is created on FIRST boot only (INIT_ROOT_*); later edits have no effect.
NOCOBASE_ROOT_USERNAME=admin
NOCOBASE_ROOT_NICKNAME=Admin
NOCOBASE_TZ=UTC
# Postgres (internal to the compose network, not published to the host).
NB_DB_NAME=nocobase
NB_DB_USER=nocobase
NB_DB_PASSWORD=change-me-db-password
