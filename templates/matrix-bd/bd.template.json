  "module": {
    "key": "bd",
    "name": "BD — site identification",
    "icon": "map-pin",
    "subject": "site",
    "members": [
      "executive",
      "supervisor"
    ],
    "delegation": true,
    "separation_of_duties": false,
    "entry_gate": null,
    "stages": [
      {
        "key": "draft",
        "name": "Draft & shortlist",
        "submit": {
          "roles": [
            "executive",
            "supervisor"
          ]
        },
        "outcome": "in_progress",
        "description": "An executive or supervisor captures the site; a supervisor shortlists, rejects or archives it.",
        "approvals": [
          {
            "role": "supervisor",
            "actions": [
              "approve",
              "reject",
              "send_back"
            ],
            "label": "Shortlist",
            "fields": [
              {
                "key": "rejection_reasons",
                "label": "Rejection reasons",
                "required": false,
                "type": "long_text",
                "validation": {
                  "pattern": "list; used only when rejecting"
                },
                "help": "list; used only when rejecting"
              }
            ]
          }
        ],
        "fields": [
          {
            "key": "rent_type",
            "label": "Rent type",
            "required": false,
            "type": "choice",
            "options": [
              {
                "value": "fixed",
                "label": "fixed"
              },
              {
                "value": "revshare",
                "label": "revshare"
              },
              {
                "value": "mg_revshare",
                "label": "mg_revshare"
              },
              {
                "value": "staggered",
                "label": "staggered"
              }
            ]
          },
          {
            "key": "expected_rent",
            "label": "Expected rent / MG / base rent",
            "required": false,
            "type": "money",
            "validation": {
              "min": 0,
              "currency": "INR"
            },
            "help": "₹ per month; required when staggered"
          },
          {
            "key": "staggered_escalation",
            "label": "Staggered escalation schedule",
            "required": false,
            "type": "long_text",
            "help": "Up to 5 rows of {year, percent}; checked by the template adapter (validateBusinessRule)."
          }
        ]
      },
      {
        "key": "details",
        "name": "Details review",
        "submit": {
          "roles": [
            "executive",
            "supervisor"
          ]
        },
        "outcome": "approved",
        "approvals": [
          {
            "role": "supervisor",
            "actions": [
              "approve",
              "reject",
              "send_back"
            ],
            "fields": [
              {
                "key": "expected_loi_days",
                "label": "Expected LOI days",
                "required": true,
                "type": "number",
                "help": "set by the supervisor at approval → LOI deadline"
              }
            ]
          }
        ],
        "fields": [
          {
            "key": "score",
            "label": "Score",
            "required": false,
            "type": "number",
            "validation": {
              "min": 1,
              "max": 5
            }
          },
          {
            "key": "est_sales",
            "label": "Estimated monthly sales",
            "required": false,
            "type": "money",
            "validation": {
              "min": 0,
              "currency": "INR"
            }
          },
          {
            "key": "nearest_competitor_a_m",
            "label": "Nearest competitor A (m)",
            "required": false,
            "type": "number"
          },
          {
            "key": "nearest_competitor_b_m",
            "label": "Nearest competitor B (m)",
            "required": false,
            "type": "number"
          },
          {
            "key": "carpet_area_sqft",
            "label": "Carpet area (sqft)",
            "required": false,
            "type": "number"
          },
          {
            "key": "cam_charges",
            "label": "CAM charges",
            "required": false,
            "type": "money",
            "validation": {
              "min": 0,
              "currency": "INR"
            }
          },
          {
            "key": "rent",
            "label": "Rent",
            "required": false,
            "type": "money",
            "validation": {
              "min": 0,
              "currency": "INR"
            }
          },
          {
            "key": "security_deposit",
            "label": "Security deposit",
            "required": false,
            "type": "money",
            "validation": {
              "min": 0,
              "currency": "INR"
            }
          },
          {
            "key": "capex",
            "label": "Capex",
            "required": false,
            "type": "money",
            "validation": {
              "min": 0,
              "currency": "INR"
            }
          },
          {
            "key": "brokerage",
            "label": "Brokerage",
            "required": false,
            "type": "money",
            "validation": {
              "min": 0,
              "currency": "INR"
            }
          },
          {
            "key": "lock_in_months",
            "label": "Lock-in (months)",
            "required": false,
            "type": "number"
          },
          {
            "key": "tenure_months",
            "label": "Tenure (months)",
            "required": false,
            "type": "number"
          },
          {
            "key": "rent_free_days",
            "label": "Rent-free days",
            "required": false,
            "type": "number"
          }
        ]
      },
      {
        "key": "loi",
        "name": "LOI",
        "submit": {
          "roles": [
            "executive",
            "supervisor"
          ]
        },
        "outcome": "done",
        "approvals": [
          {
            "role": "supervisor",
            "actions": [
              "approve",
              "send_back"
            ],
            "label": "Send to Legal",
            "fields": [
              {
                "key": "loi_send_back_comments",
                "label": "Send-back comments",
                "required": false,
                "type": "text",
                "validation": {
                  "pattern": "required when the supervisor sends the LOI back"
                },
                "help": "required when the supervisor sends the LOI back"
              }
            ]
          }
        ],
        "fields": [
          {
            "key": "loi_document",
            "label": "Signed LOI",
            "required": true,
            "type": "file"
          }
        ],
        "send_back_to": [
          "loi"
        ]
      }
    ],
    "exit": {
      "on_complete": "done",
      "on_reject": "rejected"
    },
    "adapter": {
      "key": "matrix_bd.bd",
      "version": "1.0.0",
      "hooks": [
        "afterApprove",
        "beforeSubmit",
        "validateBusinessRule"
      ],
      "config": {
        "rent_stage": "draft",
        "deadline_stage": "details",
        "deadline_field": "expected_loi_days",
        "schedule_max_rows": 5
      }
    },
    "template": {
      "key": "matrix-bd/bd",
      "version": "1.0.0"
    }
  },
