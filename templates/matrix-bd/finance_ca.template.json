          {
            "role": "supervisor",
            "actions": [
              "approve",
              "send_back"
            ]
          },
          {
            "role": "business_admin",
            "actions": [
              "approve",
              "send_back"
            ]
          }
        ],
        "fields": [
          {
            "key": "kyc_verified",
            "label": "KYC verified",
            "required": true,
            "type": "yes_no"
          },
          {
            "key": "ca_code",
            "label": "CA / Commercial code",
            "required": true,
            "type": "text",
            "help": "Unique per workspace (case-insensitive); becomes the site's display code."
          },
          {
            "key": "finance_amount",
            "label": "Amount",
            "required": true,
            "type": "money",
            "validation": {
              "min": 0,
              "currency": "INR"
            }
          }
        ]
      }
    ],
    "exit": {
      "on_complete": "approved"
    },
    "adapter": {
