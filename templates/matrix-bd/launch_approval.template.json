{
  "template": {
    "key": "matrix-bd/launch_approval",
    "version": "1.0.0",
    "title": "Launch approval",
    "source": {
      "repo": "Matrix-bd",
      "commit": "3d4f277beb22c5be02c2abacea61b6afaee7cdeb",
      "extracted_from": "building-blocks/from-matrix-bd/matrix-bd-flow.json",
      "module": "launch_approval"
    },
    "visibility": "customer-private"
  },
  "requires": {
    "subject": "site",
    "modules": [
      "nso"
    ],
    "roles": [
      "business_admin",
      "executive",
      "supervisor"
    ],
    "outcomes": [
      "approved",
      "done",
      "submitted"
    ]
  },
  "module": {
    "key": "launch_approval",
    "name": "Launch approval",
    "icon": "rocket",
    "subject": "site",
    "members": [
      "executive",
      "supervisor"
    ],
    "delegation": false,
    "entry_gate": {
      "match": "all",
      "conditions": [
        {
          "source": "nso",
          "outcome": "done"
        }
      ],
      "refusal_message": "Launch approval is locked: waiting for NSO final approval."
    },
    "stages": [
      {
        "key": "admin_review",
        "name": "Admin review",
        "submit": {
          "roles": [
            "business_admin"
          ]
        },
        "outcome": "submitted",
        "fields": [
          {
            "key": "rent_terms",
            "label": "Rent terms",
            "required": false,
            "type": "long_text",
            "validation": {
              "pattern": "field group rent-terms.json"
            },
            "help": "Rent-terms group (rent type and its conditional amounts); checked by the template adapter."
          },
          {
            "key": "admin_review_comment",
            "label": "Admin comment",
            "required": false,
            "type": "text"
          }
        ]
      },
      {
        "key": "creator_review",
        "name": "Creator review",
        "submit": {
          "roles": [
            "executive",
            "supervisor"
          ],
          "restricted_to": "subject_creator"
        },
        "outcome": "submitted",
        "fields": [
          {
            "key": "exec_verdict",
            "label": "Verdict",
            "required": true,
            "type": "choice",
            "options": [
              {
                "value": "approved",
                "label": "approved",
                "score": "positive"
              },
              {
                "value": "rejected",
                "label": "rejected",
                "score": "negative"
              }
            ]
          },
          {
            "key": "exec_comment",
            "label": "Comment",
            "required": false,
            "type": "text"
          },
          {
            "key": "rent_start_date",
            "label": "Rent start date",
            "required": true,
            "type": "date",
            "help": "The only field the site's creator may edit in this loop."
          }
        ]
      },
      {
        "key": "supervisor_review",
        "name": "Supervisor review",
        "submit": {
          "roles": [
            "supervisor"
          ]
        },
        "outcome": "submitted",
        "fields": [
          {
            "key": "supervisor_verdict",
            "label": "Verdict",
            "required": true,
            "type": "choice",
            "options": [
              {
                "value": "approved",
                "label": "approved",
                "score": "positive"
              },
              {
                "value": "rejected",
                "label": "rejected",
                "score": "negative"
              }
            ]
          },
          {
            "key": "supervisor_comment",
            "label": "Comment",
            "required": false,
            "type": "text"
          }
        ]
      },
      {
        "key": "admin_final",
        "name": "Admin final confirm",
        "submit": {
          "roles": [
            "business_admin"
          ]
        },
        "outcome": "approved",
        "fields": [
          {
            "key": "admin_final_comment",
            "label": "Final comment",
            "required": false,
            "type": "text"
          }
        ]
      },
      {
        "key": "launch",
        "name": "Launch",
        "submit": {
          "roles": [
            "business_admin"
          ]
        },
        "outcome": "done"
      }
    ],
    "exit": {
      "on_complete": "done"
    },
    "adapter": {
      "key": "matrix_bd.launch_approval",
      "version": "1.0.0",
      "hooks": [
        "afterSubmit",
        "syncExternalState",
        "validateBusinessRule"
      ]
    },
    "template": {
      "key": "matrix-bd/launch_approval",
      "version": "1.0.0"
    }
  },
