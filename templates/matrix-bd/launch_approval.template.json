  "adapter_hooks": [
    {
      "hook": "syncExternalState",
      "purpose": "Open the launch case automatically when NSO completes (consumes case.completed for nso; runtime 'open case' command).",
      "why_not_generic": "Auto-opening a module when its gate opens is not a manifest option.",
      "matrix_bd_source": "backend/app/services/nso_service.py final approval → launch_approvals",
      "generic_candidate": "module.auto_open: true"
    },
    {
      "hook": "validateBusinessRule",
      "purpose": "Rent-terms group is consistent (same rule as BD).",
      "why_not_generic": "Conditional/grouped fields (see BD).",
      "matrix_bd_source": "rent-terms.json",
      "generic_candidate": "field.required_if + 'table' field type"
    },
    {
      "hook": "afterSubmit",
      "purpose": "admin_final: emit subject.rent_terms_committed with the agreed terms; launch: emit subject.launched.",
      "why_not_generic": "Matrix-bd commits the staged terms into the site; here it becomes an event the subject owner applies — never a direct write into BD's data.",
      "matrix_bd_source": "backend/app/services/launch_service.py _commit_rent_to_canonical, launch"
    }
  ],
  "behaviour": {
    "generic": [
      "admin → creator → supervisor → admin loop as four ordered stages",
      "creator review bound to the SITE's creator (subject_creator)",
      "verdicts are data; the admin's final confirmation decides",
      "launch completes the module → opens Financial closure"
    ],
    "matrix_bd_specific": [
      "auto-open on NSO completion; rent terms committed back onto the site (adapter → events)"
    ]
  },
