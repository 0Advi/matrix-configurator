{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matrix.local/configurator/workspace.schema.json",
  "title": "Workspace document (v5 per-workspace state)",
  "description": "Shape of Component.stashOf(state) in Workspace Configurator v5.dc.html (sha256 b30033e9…2bda): the per-workspace object v5 keeps in memory and persists under localStorage['wsconfig_v5_custom'].data[<workspace id>]. Per docs/CONTRACT.md this is what cfg_workspaces.state holds. $defs.storageBlob is the whole localStorage value ({ customWs, data }). Internal (editor) shape — differs from the manifest: camelCase keys, element ids, canvas x/y, live copy, history. Validated against every seeded workspace and a real createWorkspace() blob by test/schemas.test.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["modules", "perms", "live", "liveV", "draftV", "history"],
  "properties": {
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "perms": { "type": "array", "items": { "$ref": "#/$defs/perm" } },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "perms"],
      "description": "Snapshot of the last published version (seed: Blue Tokai v7; starbucks/burgerking: the untouched Blue Tokai template; empty custom workspace: no modules).",
      "properties": {
        "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
        "perms": { "type": "array", "items": { "$ref": "#/$defs/perm" } }
      }
    },
    "liveV": { "type": "integer", "minimum": 0, "description": "0 = never published" },
    "draftV": { "type": "integer", "minimum": 1 },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "meta", "reason", "lines"],
        "properties": {
          "version": { "type": "string", "pattern": "^v[0-9]+$" },
          "meta": { "type": "string", "description": "'<date> · <publisher>' free text" },
          "reason": { "type": "string", "minLength": 1, "description": "publish requires a non-empty reason" },
          "lines": { "type": "array", "items": { "type": "string" }, "description": "first 4 diff lines" }
        }
      }
    }
  },
  "$defs": {
    "moduleKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,38}$" },
    "outcome": { "enum": ["pending", "allocated", "in progress", "submitted", "rejected", "approved", "done", "skipped"] },
    "approverRole": { "enum": ["supervisor", "executive", "business_admin"] },
    "navRole": { "enum": ["supervisor", "executive"] },
    "permRole": { "enum": ["supervisor", "executive", "business_admin", "observer"] },
    "band": { "enum": ["site", "legalfin", "design", "build", "audit", "launch"] },
    "capability": { "enum": ["G1", "G2", "G3", "G4"] },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "key", "kind", "required", "validation", "affects"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "kind": { "enum": ["choice", "yesno", "text", "number", "date", "file", "person"] },
        "required": { "type": "boolean" },
        "validation": { "type": "string" },
        "affects": { "type": "boolean" },
        "keyTouched": { "type": "boolean", "description": "editor-only: key was edited by hand (wizard)" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "approvers", "outcome", "fields", "sites"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "approvers": { "type": "array", "items": { "$ref": "#/$defs/approverRole" }, "uniqueItems": true },
        "outcome": { "$ref": "#/$defs/outcome" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "sites": { "type": "integer", "minimum": 0, "description": "sites currently sitting in this stage (drives the stage-removal decision)" }
      }
    },
    "gate": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["match", "conds", "refusal"],
          "properties": {
            "match": { "enum": ["all", "any"] },
            "conds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["src", "out"],
                "properties": { "src": { "type": "string" }, "out": { "type": "string" } }
              }
            },
            "refusal": { "type": "string" },
            "touched": { "type": "boolean", "description": "refusal edited by hand → withRefusal() stops regenerating it" }
          }
        }
      ]
    },
    "navItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "icon", "label", "page", "roles", "badge"],
      "properties": {
        "id": { "type": "string" },
        "icon": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "page": { "type": "string" },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/navRole" }, "uniqueItems": true },
        "badge": { "type": "string", "description": "'' or a BADGE_SRC id (queue, awaiting, shortlisted, in_process, archived, change_requests, team)" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "kind", "enabled", "color", "tiers", "supervisorOnly", "delegation", "rollup", "exit", "gate", "pendingEng", "status", "icon", "versions", "stages", "nav", "pages", "recon", "edits", "caps", "band", "x", "y", "sitesTotal"],
      "properties": {
        "key": { "$ref": "#/$defs/moduleKey" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["builtin", "custom"] },
        "enabled": { "type": "boolean" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executive", "supervisor", "admin"],
          "properties": { "executive": { "type": "boolean" }, "supervisor": { "const": true }, "admin": { "type": "boolean" } }
        },
        "supervisorOnly": { "type": "boolean" },
        "delegation": { "type": "boolean" },
        "rollup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": { "enum": ["all_positive", "any_negative", "count_at_least", "sum_under", "custom"] },
            "n": { "type": ["integer", "string"] },
            "of": { "type": ["integer", "string"] },
            "field": { "type": "string" },
            "limit": { "type": ["string", "number"] }
          }
        },
        "exit": { "$ref": "#/$defs/outcome" },
        "gate": { "$ref": "#/$defs/gate" },
        "pendingEng": { "type": "boolean" },
        "status": { "enum": ["live", "draft"] },
        "icon": { "type": "string", "minLength": 1 },
        "versions": {
          "type": "array",
          "description": "[[version, sitesOnThatVersion], ...]",
          "items": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "integer" }], "minItems": 2, "maxItems": 2 }
        },
        "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } },
        "nav": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "items"],
            "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "items": { "type": "array", "items": { "$ref": "#/$defs/navItem" } } }
          }
        },
        "pages": {
          "type": "array",
          "description": "[[pageId, label], ...] — targets a nav item may point at",
          "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "minItems": 2, "maxItems": 2 }
        },
        "recon": { "type": "boolean", "description": "built-in module reconfigured for this tenant" },
        "edits": { "type": "array", "items": { "type": "string" }, "description": "human-readable reconfiguration notes" },
        "caps": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true, "description": "planned platform capabilities this module depends on" },
        "band": { "$ref": "#/$defs/band" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "sitesTotal": { "type": "integer", "minimum": 0 },
        "changeRequestLoop": { "type": "boolean", "description": "built-in Legal: change requests can re-open the DDR" },
        "refusedOff": { "type": "boolean", "description": "replay artefact: an attempt to switch this module off was refused" },
        "revoked": { "type": "boolean", "description": "allocations revoked (not paused) when switched off" },
        "navItems": { "type": "array", "description": "replay artefact: the _cm() spec's nav tuples, left on the module object" }
      }
    },
    "perm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "ceiling", "roles"],
      "properties": {
        "action": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "ceiling": { "type": "array", "items": { "$ref": "#/$defs/permRole" }, "uniqueItems": true },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/permRole" }, "uniqueItems": true }
      }
    },
    "customWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug", "start", "created"],
      "properties": {
        "id": { "type": "string", "pattern": "^ws_[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
        "start": { "enum": ["empty", "template"] },
        "created": { "type": "string" }
      }
    },
    "storageBlob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customWs", "data"],
      "description": "localStorage['wsconfig_v5_custom'] — what GET/PUT /cfg/state exchange per docs/CONTRACT.md. Only custom workspaces are persisted; seeds are rebuilt from code.",
      "properties": {
        "customWs": { "type": "array", "items": { "$ref": "#/$defs/customWorkspace" } },
        "data": { "type": "object", "additionalProperties": { "$ref": "#" } }
      }
    }
  }
}
