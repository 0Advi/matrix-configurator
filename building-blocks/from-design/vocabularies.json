  "plannedCapabilities": [
    {
      "id": "G1",
      "title": "Sign-off by other teams, or several parties",
      "body": "A stage can only be signed off by tiers inside its own module. Joint audits and multi-party design sign-off need an Approvers field that accepts teams (“Supervisors of NSO”) plus an “All must sign” rule.",
      "affects": [
        "Starbucks · Audit by QA & NSO",
        "Burger King · Audit by BA & HSO",
        "Burger King · Final design (four parties)"
      ],
      "blocks": "Starbucks, Burger King"
    },
    {
      "id": "G2",
      "title": "Editable gates on built-in modules",
      "body": "Built-in modules carry platform-defined entry gates. Turning built-in Design off means Execution has to wait on a custom module instead — which the platform cannot express today.",
      "affects": [
        "Starbucks · Project team – execution",
        "Burger King · Finalise – for budget"
      ],
      "blocks": "Starbucks, Burger King"
    },
    {
      "id": "G3",
      "title": "Launch opening after custom modules",
      "body": "Launch approval is hard-wired to follow NSO. Both tenants need it to open after a custom Operations HOC handover instead.",
      "affects": [
        "Starbucks · New café launch",
        "Burger King · New café launch"
      ],
      "blocks": "Starbucks, Burger King"
    },
    {
      "id": "G4",
      "title": "Committee approvers",
      "body": "CEO and CPO approve by holding the business admin role, so the audit trail cannot tell them apart. A real committee role is a platform change, not configuration.",
      "affects": [
        "Starbucks · Property Committee (CEO / CPO)",
        "Burger King · Property Committee (with CEO / CPO)"
      ],
      "blocks": "Starbucks, Burger King"
    }
  ],
